<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-build-only manifest fragment, merged over src/main/AndroidManifest.xml
    (and the manager flavor's own src/manager/AndroidManifest.xml) for debug
    builds of both product flavors — adds the cleartext network security
    config (see res/xml/network_security_config.xml in this same source
    set) needed to reach a local-dev backend per ADR-003
    (docs/architecture/10_ARCHITECTURE_DECISIONS_ADR/ADR-003_ENVIRONMENT_CONFIGURATION_STRATEGY.md)
    - the Android Emulator alias, or a developer's own LAN IP for
    physical-device testing (see local.properties.sample). Never merged
    into a release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
