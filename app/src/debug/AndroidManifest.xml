<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-build-only manifest fragment, merged over src/main/AndroidManifest.xml
    (and the manager flavor's own src/manager/AndroidManifest.xml) for debug
    builds of both product flavors — adds the cleartext network security
    config (see res/xml/network_security_config.xml in this same source
    set) needed to reach the local-dev backend at 10.0.2.2:8080. Never
    merged into a release build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
