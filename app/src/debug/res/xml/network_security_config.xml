<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-build-only (this file lives under src/debug/, never merged into a
    release build) — permits plaintext HTTP for local development/testing
    per ADR-003
    (docs/architecture/10_ARCHITECTURE_DECISIONS_ADR/ADR-003_ENVIRONMENT_CONFIGURATION_STRATEGY.md).
    A domain-by-domain whitelist (10.0.2.2 / localhost / 127.0.0.1) isn't
    enough on its own: physical-device testing now targets each
    developer's own LAN IP (DEV_API_BASE_URL in local.properties, see
    local.properties.sample), which is DHCP-assigned and differs per
    developer/network - there's no fixed address to enumerate here. A
    debug-only base-config allowing cleartext broadly covers the emulator
    alias, adb-reverse loopback, and any developer's LAN IP alike, without
    hardcoding a value that would go stale. Modern Android (targetSdk 28+)
    blocks cleartext traffic by default; there is no deployed HTTPS
    backend yet to test debug builds against (see NetworkConfig.kt), so
    this is what lets local development/testing actually reach it.
    Release builds get no such config (this file is debug-source-set-only)
    and stay cleartext-blocked everywhere, as they should once a real
    HTTPS backend URL is configured per build type.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
