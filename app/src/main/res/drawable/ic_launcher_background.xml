<?xml version="1.0" encoding="utf-8"?>
<!--
    Icon-clipping fix: this was still Android Studio's unmodified default
    template background (flat #3DDC84 green + alignment guide grid) —
    never replaced with a brand color. ic_launcher_foreground.webp has
    transparent margins around its own rounded-square artwork, so that
    default green was showing through in the gaps whenever a launcher's
    mask shape exposed more than the foreground's own opaque area —
    visible as green bleeding outside the icon's rounded-square boundary.
    Fixed to a solid fill using RojanDeepPurple (ui/theme/RojanTokens.kt,
    #2B1F45 — an existing brand token, not a new color) so any exposed
    margin matches the app's own dark-purple palette instead of the
    leftover template green. Guide grid removed — never rendered
    artwork, just Android Studio's default alignment guides.
-->
<vector
    android:height="108dp"
    android:width="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <path android:fillColor="#2B1F45"
          android:pathData="M0,0h108v108h-108z"/>
</vector>
