<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        ROJAN Manager flavor manifest — merged with src/main/AndroidManifest.xml
        (unchanged, still Customer's manifest). Only what differs for the
        Manager app lives here: its own launcher icon and its own entry
        Activity. android:label stays "@string/app_name" (inherited from
        main) — the string VALUE is overridden per-flavor instead, via
        src/manager/res/values/strings.xml, so no manifest attribute
        conflict is needed for the label.
    -->

    <application
        android:icon="@drawable/rojan_manager_logo"
        android:roundIcon="@drawable/rojan_manager_logo"
        tools:replace="android:icon,android:roundIcon">

        <!--
            This flavor doesn't use Customer's MainActivity/RojanNavGraph
            at all — removed entirely (not just its launcher intent-filter)
            so the Manager APK has exactly one launcher entry point,
            ManagerActivity below. This removal only applies when building
            the `manager` flavor; Customer's own manifest/activity are
            untouched.
        -->
        <activity
            android:name=".MainActivity"
            tools:node="remove" />

        <activity
            android:name=".ManagerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ROJAN_DesignLab"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
