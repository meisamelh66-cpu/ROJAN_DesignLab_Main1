# ROJAN — release signing credentials TEMPLATE.
#
# Copy this file to `keystore.properties` (repo root) and fill in the real
# values. `keystore.properties` and `*.jks` are gitignored — never commit
# either. On CI, do NOT create this file; export the same four keys as
# environment variables instead (app/build.gradle.kts reads either source).
#
# A *production* release build (assemble/bundleCustomerProductionRelease)
# fails loudly if none of these resolve — it will not emit an unsigned APK/AAB.
# `dev`/`staging` release and all `debug` builds are unaffected.

# Path to the release keystore, relative to the repo root (or absolute).
RELEASE_STORE_FILE=keystore/rojan-customer-upload.jks

# Keystore password.
RELEASE_STORE_PASSWORD=change-me

# Key alias inside the keystore.
RELEASE_KEY_ALIAS=rojan-customer-upload

# Key password (same as the store password for a PKCS12 keystore created the
# standard way).
RELEASE_KEY_PASSWORD=change-me
