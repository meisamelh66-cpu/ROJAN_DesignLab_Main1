# ROJAN — release signing credentials TEMPLATE.
#
# Copy this file to `keystore.properties` (repo root) and fill in the real
# values. `keystore.properties` and `*.jks` are gitignored — never commit
# either. On CI, do NOT create this file; export the same eight keys as
# environment variables instead (app/build.gradle.kts reads either source).
#
# Customer and Manager each have their own, independent production signing
# identity — a single shared keystore cannot represent both, so each flavor
# resolves its own CUSTOMER_RELEASE_* / MANAGER_RELEASE_* set.
#
# A *production* release build (assemble/bundleCustomerProductionRelease,
# assemble/bundleManagerProductionRelease) fails loudly if its own flavor's
# four values don't all resolve — it will not emit an unsigned APK/AAB.
# `dev`/`staging` release and all `debug` builds are unaffected. Reception
# has no production signing identity at all; its ProductionRelease tasks are
# refused outright.

# --- Customer -----------------------------------------------------------

# Path to the Customer release keystore, relative to the repo root (or absolute).
CUSTOMER_RELEASE_STORE_FILE=keystore/rojan-customer-upload.jks

# Keystore password.
CUSTOMER_RELEASE_STORE_PASSWORD=change-me

# Key alias inside the keystore.
CUSTOMER_RELEASE_KEY_ALIAS=rojan-customer-upload

# Key password (same as the store password for a PKCS12 keystore created the
# standard way).
CUSTOMER_RELEASE_KEY_PASSWORD=change-me

# --- Manager --------------------------------------------------------------

# Path to the Manager release keystore, relative to the repo root (or absolute).
MANAGER_RELEASE_STORE_FILE=keystore/rojan-manager-upload.jks

# Keystore password.
MANAGER_RELEASE_STORE_PASSWORD=change-me

# Key alias inside the keystore.
MANAGER_RELEASE_KEY_ALIAS=change-me

# Key password (same as the store password for a PKCS12 keystore created the
# standard way).
MANAGER_RELEASE_KEY_PASSWORD=change-me
